# Local development configuration.
#
#   cp .env.example .env
#
# Task 0.5 replaces this with validated, typed configuration. For now these values
# are consumed only by infra/docker-compose.yml.
#
# These are DEVELOPMENT-ONLY credentials. They are deliberately committed so a new
# contributor can start the stack. Never reuse them anywhere reachable from a
# network, and never commit a real secret to this repository.

# ---- PostgreSQL ----
# Host port defaults to 5433: Homebrew postgresql commonly holds 5432.
POSTGRES_USER=ai_workspace
POSTGRES_PASSWORD=ai_workspace_dev_password
POSTGRES_DB=ai_workspace
POSTGRES_PORT=5433

# ---- Redis ----
# Host port defaults to 6380: Homebrew redis commonly holds 6379.
REDIS_PORT=6380

# ---- MinIO (S3-compatible object storage) ----
MINIO_ROOT_USER=ai_workspace
MINIO_ROOT_PASSWORD=ai_workspace_dev_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=ai-workspace-documents

# ---- API (only used by the optional `api` compose profile) ----
API_PORT=8000

# =====================================================================
# Application configuration
#
# Everything above configures the containers. Everything below is read by the
# applications themselves.
#
# HOST vs CONTAINER (ADR-013): the values below are what a process running on
# YOUR MACHINE needs — localhost plus the published ports. Containers cannot use
# them; infra/docker-compose.yml overrides them per service with in-cluster
# addresses (postgres:5432, redis:6379, minio:9000). Keep this file host-facing.
# =====================================================================

# ---- API ----
# local | test | staging | production
ENVIRONMENT=local
LOG_LEVEL=INFO

# Must agree with POSTGRES_* and POSTGRES_PORT above.
DATABASE_URL=postgresql+psycopg://ai_workspace:ai_workspace_dev_password@localhost:5433/ai_workspace
REDIS_URL=redis://localhost:6380/0

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=ai_workspace
S3_SECRET_KEY=ai_workspace_dev_password
S3_REGION=us-east-1

# ---- Web ----
# NEXT_PUBLIC_* is compiled into the browser bundle and is world-readable.
# Never put a secret behind that prefix.
NEXT_PUBLIC_API_URL=http://localhost:8000
