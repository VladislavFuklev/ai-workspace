# Local development configuration.
#
#   cp .env.example .env
#
# Task 0.5 replaces this with validated, typed configuration. For now these values
# are consumed only by infra/docker-compose.yml.
#
# These are DEVELOPMENT-ONLY credentials. They are deliberately committed so a new
# contributor can start the stack. Never reuse them anywhere reachable from a
# network, and never commit a real secret to this repository.

# ---- PostgreSQL ----
# Host port defaults to 5433: Homebrew postgresql commonly holds 5432.
POSTGRES_USER=ai_workspace
POSTGRES_PASSWORD=ai_workspace_dev_password
POSTGRES_DB=ai_workspace
POSTGRES_PORT=5433

# ---- Redis ----
# Host port defaults to 6380: Homebrew redis commonly holds 6379.
REDIS_PORT=6380

# ---- MinIO (S3-compatible object storage) ----
MINIO_ROOT_USER=ai_workspace
MINIO_ROOT_PASSWORD=ai_workspace_dev_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=ai-workspace-documents

# ---- API (only used by the optional `api` compose profile) ----
API_PORT=8000
